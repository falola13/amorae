# Base URL of the Go API. The browser never sees this — Next.js calls it
# server-to-server (see src/lib/api/client.ts).
API_URL=http://localhost:8088

# Whether the amorae_session cookie gets the `Secure` flag. Must be "true"
# behind HTTPS; "false" for plain-http local/staging setups. Defaults to
# NODE_ENV === "production" when unset (see src/lib/env.ts).
COOKIE_SECURE=false

# Shared with the API (apps/api BFF_SECRET, same value, at least 32
# characters). Lets this server vouch for each visitor's IP so the API's
# auth rate limit counts per visitor, not per this server. Optional in
# development; generate one with `openssl rand -hex 32` for real deploys.
BFF_SECRET=
