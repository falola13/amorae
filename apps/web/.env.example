# Base URL of the Go API. The browser never sees this: Server Actions call it
# server-to-server, and browser calls go through /api/v1/* (a route handler
# that adds the session's bearer token). See src/lib/api/client.ts and
# src/app/api/v1/[...path]/route.ts.
API_URL=http://localhost:8088

# Whether the amorae_session cookie gets the `Secure` flag. Must be "true"
# behind HTTPS. Defaults to NODE_ENV === "production" when unset.
COOKIE_SECURE=false

# Shared with the API (apps/api BFF_SECRET, same value, at least 32 chars).
BFF_SECRET=

# Web Push. This is the PUBLIC half of the pair in apps/api/.env
# (VAPID_PUBLIC_KEY) and must be exactly the same string: the browser hands it
# to its push service when subscribing, and the API signs with the private
# half. A mismatch fails at subscribe time, not at send time, so it looks like
# "push just doesn't work" rather than like a wrong key.
#
# Left empty here on purpose. Empty means usePush() never subscribes, so
# nothing is stored and the worker has nobody to send to — which is the right
# behaviour for a checkout with no keys, but worth knowing when push seems
# silent. Generate a pair once; the private half belongs in a secret store.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
