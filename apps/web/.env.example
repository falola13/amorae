# Base URL of the Go API. The browser never sees this: Server Actions call it
# server-to-server, and browser calls go through /api/v1/* (a route handler
# that adds the session's bearer token). See src/lib/api/client.ts and
# src/app/api/v1/[...path]/route.ts.
API_URL=http://localhost:8088

# Whether the amorae_session cookie gets the `Secure` flag. Must be "true"
# behind HTTPS. Defaults to NODE_ENV === "production" when unset.
COOKIE_SECURE=false

# Shared with the API (apps/api BFF_SECRET, same value, at least 32 chars).
BFF_SECRET=

# Mock mode, for working on the front end before the Go modules for prayers,
# events, goals and the rest exist. One flag drives both halves: sign-in
# issues a local session for ANY email and password, and the browser answers
# every /api/v1 call from a localStorage store (src/lib/api/mock). It's read
# at build time. Turn it off once the API is live.
NEXT_PUBLIC_API_MOCK=true

# Mock sign-in accepts any password, so a production build refuses it unless
# this is true. Set it only for a deliberate public demo.
ALLOW_MOCK_AUTH=false

# Web Push. The private key stays on the Go side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
