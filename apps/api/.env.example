# Copy to .env for local development. cmd/api and cmd/migrate load it via
# godotenv; a missing file is fine (production sets real env vars instead).
# Keep comments on their own lines: inline "# ..." after a value is not
# portable across env-file parsers (Docker's --env-file keeps it verbatim).

# development | production
APP_ENV=development
HTTP_ADDR=:8088

# Required. Matches the `db` service in docker-compose.yml (published on 5434).
DATABASE_URL=postgres://amorae:amorae@localhost:5434/amorae?sslmode=disable
DB_MAX_CONNS=10

# debug | info | warn | error
LOG_LEVEL=info
# text | json. Empty means json in production, text otherwise.
LOG_FORMAT=

SESSION_TTL=720h

# Separate listener for Prometheus /metrics, never the public API port.
# Loopback by default; in a container use :9090 and don't publish it.
METRICS_ADDR=127.0.0.1:9090

# Shared with apps/web. Lets the web server vouch for each visitor's real
# IP, which the auth rate limit keys on. At least 32 characters; must match
# the web app's BFF_SECRET. Leave empty to trust no forwarded IP.
BFF_SECRET=
# 4..31. Each +1 doubles hashing time; 12 is ~250ms on typical hardware.
BCRYPT_COST=12
SHUTDOWN_TIMEOUT=15s

# Web push (RFC 8292). Without a pair the worker still decides everything and
# logs what it would have sent, so local work needs no keys. Generate a pair
# once and keep the private one in your secret store — changing it
# invalidates every existing subscription.
#   VAPID_SUBJECT is a mailto: or https: URL the push service can contact.
# The public key also has to reach the browser, as the web app's
# NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
